# Modèle de fichier .env pour la mise en ligne (PythonAnywhere).
# Copier ce fichier sous le nom .env sur le serveur, puis remplacer les valeurs.
# Ne jamais envoyer le vrai fichier .env à qui que ce soit : il contient la clé secrète.

# Clé secrète : en générer une avec la commande (dans la console Bash du serveur) :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacer-par-la-cle-generee

# 0 = production (obligatoire en ligne)
DJANGO_DEBUG=0

# Adresse du site : remplacer « votrenom » par votre nom d'utilisateur PythonAnywhere
DJANGO_ALLOWED_HOSTS=votrenom.pythonanywhere.com
